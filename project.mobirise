  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "KetoVera – Advanced Support for Nerve Health",
        "meta_descr": "KetoVera is a liquid dietary supplement that is meant to assist with the weight management and overall wellness regimen on a daily basis. The dropper design of the supplement allows it to be easily used in an individual’s daily routine along with a blend of ingredients which includes plant extracts, nutrients, and metabolic formulas. The supplement is best used as a compliment to one’s healthy lifestyle choices and not as a substitute to a healthy diet, exercise, good sleep, water intake, or any medical treatments. Ingredients like Chromium Picolinate, African Mango, Maca Root, Green Tea, Guarana, Gymnema Sylvestre, Raspberry Ketones, and L-Carnitine are some of the highlighted ingredients of this formula.",
        "header_custom": "<meta name=\"keywords\" content=\"prosta defend, prostadefend, prosta defend supplement, prosta defend pills\">\n <meta name=\"author\" content=\"prosta defend\">\n\t\t\n <link rel=\"canonical\" href=\"\" >",
        "footer_custom": "",
        "html_before": "",
        "meta_image": "@PROJECT_PATH@/assets/images/download-2.webp"
      },
